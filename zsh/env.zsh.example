# Machine environment. This file stays outside the repository.
# Shared setup already discovers Homebrew, Bun, pnpm, Cargo and cmux.
# Supply private tokens here or through your credential manager.

# Preserve this Mac's external Android storage only on machines with that disk:
# export ANDROID_SDK_ROOT=/Volumes/LaCie/Android/sdk
# export ANDROID_HOME=$ANDROID_SDK_ROOT
# export ANDROID_AVD_HOME=/Volumes/LaCie/Android/avd
# export GRADLE_USER_HOME=/Volumes/LaCie/Android/gradle
# path=("$ANDROID_SDK_ROOT/cmdline-tools/latest/bin" "$ANDROID_SDK_ROOT/platform-tools" $path)

# Select Java per machine/project, rather than requiring Java 26 everywhere:
# export JAVA_HOME=$(/usr/libexec/java_home -v 26)
# path=("$JAVA_HOME/bin" $path)

# Only enable the legacy AWS config override if ~/.aws is a config FILE:
# export AWS_CONFIG_FILE=$HOME/.aws
